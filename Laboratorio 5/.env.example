# Plantilla del .env. scripts/generar_env.sh copia este archivo a .env y cambia las claves por
# valores aleatorios. El .env real queda solo en la VM y no se sube al repositorio.

# Broker MQTT
MQTT_USUARIO=estacion
MQTT_CLAVE=cambiar

# InfluxDB 2 (TSDB)
INFLUX_USUARIO=admin
INFLUX_CLAVE=cambiar
INFLUX_ORG=unab
INFLUX_BUCKET=lab5
INFLUX_TOKEN=cambiar

# Grafana (usuario admin)
GRAFANA_CLAVE=cambiar

# Publicador
DISPOSITIVO_ID=estacion-01
INTERVALO_S=10
