      },
      {
        "@type": [
          "Telemetry",
          "RelativeHumidity",
          "NumberValue"
        ],
        "name": "hrBodega",
        "displayName": {
          "es": "Humedad relativa de la bodega (%)",
          "en": "Humedad relativa de la bodega (%)"
        },
        "schema": "double",
        "unit": "percent",
        "minValue": 0,
        "maxValue": 100,
        "decimalPlaces": 1,
        "comment": "Sensirion SHT31-D: 0-100 % HR, +/-2 %. Grano seco exige HR < 70 %"
      },
      {
        "@type": [
          "Telemetry",
          "NumberValue"
        ],
        "name": "eventosAcceso",
        "displayName": {
