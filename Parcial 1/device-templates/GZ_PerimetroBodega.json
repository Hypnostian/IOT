[
  {
    "@id": "dtmi:granjazenon:cacao:PerimetroBodega;1",
    "@type": "Interface",
    "displayName": {
      "es": "GZ Perimetro y Bodega",
      "en": "GZ Perimetro y Bodega"
    },
    "description": {
