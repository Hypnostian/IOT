          "en": "Bateria de respaldo (%)"
        },
        "schema": "integer",
        "unit": "percent",
        "minValue": 0,
        "maxValue": 100
      },
      {
        "@type": [
          "Property",
          "StringValue"
        ],
        "name": "zona",
