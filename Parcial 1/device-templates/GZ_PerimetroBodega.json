          "es": "Puerta de bodega",
          "en": "Puerta de bodega"
        },
        "schema": "boolean",
        "trueName": "Abierta",
        "falseName": "Cerrada",
        "comment": "Contacto magnetico MC-38, distancia de operacion 15-25 mm"
      },
      {
        "@type": [
          "Telemetry",
          "BooleanValue"
        ],
        "name": "movimiento",
        "displayName": {
          "es": "Deteccion de movimiento",
          "en": "Deteccion de movimiento"
        },
        "schema": "boolean",
        "trueName": "Movimiento",
        "falseName": "Sin movimiento",
        "comment": "PIR HC-SR501: alcance 3-7 m, angulo 110-120 grados"
      },
      {
        "@type": [
          "Telemetry",
          "Temperature",
          "NumberValue"
        ],
        "name": "tempBodega",
        "displayName": {
          "es": "Temperatura de la bodega (C)",
          "en": "Temperatura de la bodega (C)"
