# -------------------------------------------------------------------------
# Plantilla de configuracion de la flota "Granja Zenon - Cacao".
#
#   cp .env.example .env    y completa los valores.
#
# El archivo .env esta en .gitignore: NUNCA se sube al repositorio.
# Requisito del parcial: "Credenciales solo por variable de entorno o DPS
# attested".
# -------------------------------------------------------------------------

# --- Azure IoT Central ----------------------------------------------------
# Administration -> Device connection groups -> SAS-IoT-Devices
#   "Ambito de ID"                     -> GZ_ID_SCOPE
#   "Clave firma de acceso compartido" -> GZ_GROUP_SAS_KEY  (clave PRIMARIA)
#
# De esta clave de grupo se deriva la clave de cada dispositivo con
#   device_key = Base64(HMAC-SHA256(Base64Decode(group_key), device_id))
# de modo que ningun nodo lleva la clave maestra.
GZ_ID_SCOPE=0neXXXXXXXX
GZ_GROUP_SAS_KEY=pega-aqui-la-clave-sas-primaria-del-grupo

# Endpoint global de DPS (no cambiar salvo nube soberana).
GZ_DPS_ENDPOINT=global.azure-devices-provisioning.net

# --- Azure Maps / Atlas Weather (dev06) -----------------------------------
GZ_MAPS_SUBSCRIPTION_KEY=pega-aqui-la-api-key-de-azure-maps
GZ_MAPS_CLIENT_ID=pega-aqui-el-client-id-de-azure-maps

# --- Ubicacion del predio -------------------------------------------------
# Vereda La Colorada, San Vicente de Chucuri, Santander (Colombia).
GZ_LAT=6.88060
GZ_LON=-73.41030
GZ_ALTITUD_M=692
GZ_TZ=America/Bogota
