[Unit]
Description=Granja Zenon - Dosel y sombrio (Python SDK, MQTT sobre WebSocket 443, 60 s)
Documentation=file:///opt/granjazenon/README.md
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=zenon
Group=zenon
WorkingDirectory=/opt/granjazenon
ExecStart=/opt/granjazenon/.venv/bin/python /opt/granjazenon/dev04_dosel_websocket.py
Restart=always
RestartSec=20
# La VM tiene menos de 1 GiB: se acota cada nodo para que un pico no
# se lleve por delante al resto de la flota.
MemoryMax=180M
StandardOutput=append:/opt/granjazenon/logs/dev04.log
StandardError=append:/opt/granjazenon/logs/dev04.log
SyslogIdentifier=gz-dev04

[Install]
WantedBy=multi-user.target
