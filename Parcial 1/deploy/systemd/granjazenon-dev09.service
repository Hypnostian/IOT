[Unit]
Description=Granja Zenon - Reservorio y riego (puente HTTP/REST, 120 s)
Documentation=file:///opt/granjazenon/README.md
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=zenon
Group=zenon
WorkingDirectory=/opt/granjazenon
ExecStart=/opt/granjazenon/.venv/bin/python /opt/granjazenon/dev09_riego_http_rest.py
Restart=always
RestartSec=20
# La VM tiene menos de 1 GiB: se acota cada nodo para que un pico no
# se lleve por delante al resto de la flota.
MemoryMax=180M
StandardOutput=append:/opt/granjazenon/logs/dev09.log
StandardError=append:/opt/granjazenon/logs/dev09.log
SyslogIdentifier=gz-dev09

[Install]
WantedBy=multi-user.target
