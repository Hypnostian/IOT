[Unit]
Description=Granja Zenon - Lote de cultivo 2 (Python SDK, DPS + MQTT 8883, 15 s)
Documentation=file:///opt/granjazenon/README.md
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=zenon
Group=zenon
WorkingDirectory=/opt/granjazenon
ExecStart=/opt/granjazenon/.venv/bin/python /opt/granjazenon/dev02_lote2_dps_mqtt.py
Restart=always
RestartSec=20
# La VM tiene menos de 1 GiB: se acota cada nodo para que un pico no
# se lleve por delante al resto de la flota.
MemoryMax=180M
StandardOutput=append:/opt/granjazenon/logs/dev02.log
StandardError=append:/opt/granjazenon/logs/dev02.log
SyslogIdentifier=gz-dev02

[Install]
WantedBy=multi-user.target
