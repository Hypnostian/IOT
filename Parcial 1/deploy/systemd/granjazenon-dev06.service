[Unit]
Description=Granja Zenon - Meteorologia del predio (Atlas Weather / Azure Maps, 300 s)
Documentation=file:///opt/granjazenon/README.md
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=zenon
Group=zenon
WorkingDirectory=/opt/granjazenon
ExecStart=/opt/granjazenon/.venv/bin/python /opt/granjazenon/dev06_meteo_atlas_weather.py
Restart=always
RestartSec=20
# La VM tiene menos de 1 GiB: se acota cada nodo para que un pico no
# se lleve por delante al resto de la flota.
MemoryMax=180M
StandardOutput=append:/opt/granjazenon/logs/dev06.log
StandardError=append:/opt/granjazenon/logs/dev06.log
SyslogIdentifier=gz-dev06

[Install]
WantedBy=multi-user.target
